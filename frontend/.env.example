# Base URL of the NeighborNest API Gateway.
# The gateway already enables CORS for all origins, so you can point directly at it.
# Default (when unset or empty): http://localhost:8080
#
# OPTIONAL: set VITE_API_URL= (empty string) in a local `.env.local` to send
# same-origin requests through the Vite dev proxy defined in vite.config.ts.
VITE_API_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Optional browser keep-alive (DISABLED by default)
# ---------------------------------------------------------------------------
# When set to 'true', the app invisibly pings GET /health on the backend every
# VITE_KEEP_ALIVE_INTERVAL_MS. It renders nothing and never affects the UI,
# auth, router, or chat. It is an OPTIONAL convenience only — it cannot keep a
# sleeping backend awake when no browser is open. Prefer an external
# uptime/monitoring service that calls /health periodically instead.
VITE_ENABLE_KEEP_ALIVE=false
# Ping interval in milliseconds (default: 600000 = every 10 minutes).
VITE_KEEP_ALIVE_INTERVAL_MS=600000
