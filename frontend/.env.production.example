# NeighborNest frontend — production build variables.
# Set these in the Vercel project (Settings -> Environment Variables) rather
# than committing them:
#
#   VITE_API_URL=https://neighbornest-api.duckdns.org
#
# This single variable drives BOTH the REST calls (axios baseURL) and the
# chat WebSocket endpoint (SockJS connects to ${VITE_API_URL}/ws/chat).
# It must be HTTPS, otherwise browsers will block the API calls from the
# HTTPS-served Vercel page (mixed content).
VITE_API_URL=https://neighbornest-api.duckdns.org
