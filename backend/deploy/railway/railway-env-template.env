# ==============================================================================
# NeighborNest — Railway Environment Variables Template
# ==============================================================================
# Copy these into each service's Variables tab on Railway.
# Use ${{ServiceName.VARIABLE}} syntax to reference other services' variables.
# Generate JWT_SECRET and INTERNAL_API_KEY locally before deploying:
#   JWT_SECRET=$(openssl rand -base64 64)
#   INTERNAL_API_KEY=$(openssl rand -hex 32)
# ==============================================================================

# ── eureka-service ──────────────────────────────────────────────────────────────
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-service.railway.internal:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=false

# ── auth-service ────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://${{MySQL.MYSQLHOST}}:${{MySQL.MYSQLPORT}}/neighbornest_auth?useSSL=false&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=${{MySQL.MYSQLUSER}}
SPRING_DATASOURCE_PASSWORD=${{MySQL.MYSQLPASSWORD}}
JWT_SECRET=CHANGE_ME_base64_encoded_64_bytes
EUREKA_SERVER_URL=http://eureka-service.railway.internal:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=false
INTERNAL_API_KEY=CHANGE_ME_hex_32_bytes

# ── user-service ────────────────────────────────────────────────────────────────
MYSQLHOST=${{MySQL.MYSQLHOST}}
MYSQLPORT=${{MySQL.MYSQLPORT}}
MYSQL_USER=${{MySQL.MYSQLUSER}}
MYSQL_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=user_db
JWT_SECRET=CHANGE_ME_base64_encoded_64_bytes
EUREKA_SERVER_URL=http://eureka-service.railway.internal:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=false
RABBITMQ_HOST=rabbitmq.railway.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=neighbornest
RABBITMQ_PASSWORD=neighbornest

# ── matching-service ────────────────────────────────────────────────────────────
MYSQLHOST=${{MySQL.MYSQLHOST}}
MYSQLPORT=${{MySQL.MYSQLPORT}}
MYSQL_USER=${{MySQL.MYSQLUSER}}
MYSQL_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=matching_db
JWT_SECRET=CHANGE_ME_base64_encoded_64_bytes
EUREKA_SERVER_URL=http://eureka-service.railway.internal:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=false
RABBITMQ_HOST=rabbitmq.railway.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=neighbornest
RABBITMQ_PASSWORD=neighbornest

# ── nest-service ────────────────────────────────────────────────────────────────
MYSQLHOST=${{MySQL.MYSQLHOST}}
MYSQLPORT=${{MySQL.MYSQLPORT}}
MYSQL_USER=${{MySQL.MYSQLUSER}}
MYSQL_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=nest_db
JWT_SECRET=CHANGE_ME_base64_encoded_64_bytes
EUREKA_SERVER_URL=http://eureka-service.railway.internal:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=false
RABBITMQ_HOST=rabbitmq.railway.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=neighbornest
RABBITMQ_PASSWORD=neighbornest

# ── chat-service ────────────────────────────────────────────────────────────────
MYSQLHOST=${{MySQL.MYSQLHOST}}
MYSQLPORT=${{MySQL.MYSQLPORT}}
MYSQL_USER=${{MySQL.MYSQLUSER}}
MYSQL_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=chat_db
JWT_SECRET=CHANGE_ME_base64_encoded_64_bytes
EUREKA_SERVER_URL=http://eureka-service.railway.internal:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=false
RABBITMQ_HOST=rabbitmq.railway.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=neighbornest
RABBITMQ_PASSWORD=neighbornest
STOMP_RELAY_HOST=rabbitmq.railway.internal
STOMP_RELAY_PORT=61613

# ── notification-service ────────────────────────────────────────────────────────
MYSQLHOST=${{MySQL.MYSQLHOST}}
MYSQLPORT=${{MySQL.MYSQLPORT}}
MYSQL_USER=${{MySQL.MYSQLUSER}}
MYSQL_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_NAME=notification_db
JWT_SECRET=CHANGE_ME_base64_encoded_64_bytes
EUREKA_SERVER_URL=http://eureka-service.railway.internal:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=false
RABBITMQ_HOST=rabbitmq.railway.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=neighbornest
RABBITMQ_PASSWORD=neighbornest
INTERNAL_API_KEY=CHANGE_ME_hex_32_bytes
NOTIFICATION_BASE_URL=https://your-frontend.vercel.app
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_PRIVATE_KEY=your-emailjs-private-key
EMAILJS_SERVICE_ID=your-emailjs-service-id

# ── api-gateway ─────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_base64_encoded_64_bytes
EUREKA_SERVER_URL=http://eureka-service.railway.internal:8761/eureka/
EUREKA_INSTANCE_PREFER_IP_ADDRESS=false
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
