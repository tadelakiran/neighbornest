# ============================================================================
# NeighborNest single-container — environment variables
# ============================================================================
# Copy to a real .env (docker run --env-file, Render env vars, or a shell
# export) and fill in real secrets. NEVER commit this file with real values.
#
# Only MYSQL_PASSWORD is strictly required — every other variable has a safe
# default (localhost for MySQL/RabbitMQ/Eureka/STOMP, DEV JWT secret, etc.).

# --- required ---
# Password for MySQL root; all six services log in as root with this.
MYSQL_PASSWORD=change-me-to-a-long-random-string

# --- secrets (strongly recommended to set in production) ---
# Shared JWT signing secret, base64. Generate: openssl rand -base64 64
JWT_SECRET=
# Shared secret between auth-service and notification-service (must match).
INTERNAL_API_KEY=
# Comma-separated frontend origins allowed by the gateway CORS filter,
# e.g. https://<your-app>.vercel.app
CORS_ALLOWED_ORIGINS=
# Frontend URL used in email deep links, e.g. https://<your-app>.vercel.app
NOTIFICATION_BASE_URL=
# RabbitMQ credentials (default user: neighbornest / pass: neighbornest).
RABBITMQ_USER=neighbornest
RABBITMQ_PASSWORD=

# --- optional ---
# Path to a mysqldump (the six app databases) to import on first boot.
# The file is renamed to <path>.imported after import so it runs only once.
IMPORT_DUMP_PATH=
# JVM memory budget for the domain services + gateway. Tighten on a 4 GB
# instance: -Xmx384m -Xms192m -XX:MaxMetaspaceSize=192m
JAVA_TOOL_OPTIONS=-Xmx512m -Xms256m -XX:MaxMetaspaceSize=256m
# Eureka gets a smaller budget (it does almost nothing).
JAVA_TOOL_OPTIONS_EUREKA=-Xmx256m -Xms128m -XX:MaxMetaspaceSize=192m

# --- EmailJS (notification-service) — override the dev defaults in prod ---
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_OTP_VERIFICATION=
EMAILJS_TEMPLATE_PASSWORD_RESET=
EMAILJS_TEMPLATE_WELCOME=
