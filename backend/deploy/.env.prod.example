# NeighborNest production environment — copy to backend/.env.prod and fill in.
# .env.prod is git-ignored (see backend/.gitignore); NEVER commit real secrets.
#
# Generate secrets with:
#   openssl rand -base64 64        (JWT_SECRET)
#   openssl rand -hex 16           (MYSQL_PASSWORD, INTERNAL_API_KEY)

# Free DuckDNS subdomain for the API (create at https://www.duckdns.org and
# point its A record at the VM's public IP). Caddy issues a Let's Encrypt cert.
API_DOMAIN=neighbornest-api.duckdns.org

# MySQL root password — all backend services authenticate as root against the
# containerized MySQL.
MYSQL_PASSWORD=

# Base64 JWT signing secret, shared by ALL services.
JWT_SECRET=

# Shared secret for auth-service <-> notification-service internal calls.
INTERNAL_API_KEY=

# Comma-separated list of allowed browser origins (your Vercel app URL).
CORS_ALLOWED_ORIGINS=https://neighbornest.vercel.app

# Frontend URL used in email deep links (same as the CORS origin).
NOTIFICATION_BASE_URL=https://neighbornest.vercel.app

# --- EmailJS (notification-service) — optional ------------------------------
# The compose file has working dev defaults; override with your own dashboard
# keys/templates here if you want real OTP / welcome emails.
#EMAILJS_PUBLIC_KEY=
#EMAILJS_PRIVATE_KEY=
#EMAILJS_SERVICE_ID=
#EMAILJS_TEMPLATE_OTP_VERIFICATION=
#EMAILJS_TEMPLATE_PASSWORD_RESET=
#EMAILJS_TEMPLATE_WELCOME=
#EMAILJS_TEMPLATE_NEST_WELCOME=
#EMAILJS_TEMPLATE_NEST_GRADUATE=
#EMAILJS_TEMPLATE_NEST_DISBANDED=
#EMAILJS_TEMPLATE_MEETING_REMINDER=
#EMAILJS_TEMPLATE_EXPENSE_ALERT=
#EMAILJS_TEMPLATE_VIBE_CHECK_REMINDER=
#EMAILJS_TEMPLATE_CHAT_OFFLINE=
#EMAILJS_TEMPLATE_RAW_EMAIL=

# --- RabbitMQ (optional) ----------------------------------------------------
#RABBITMQ_USER=neighbornest
#RABBITMQ_PASSWORD=neighbornest
